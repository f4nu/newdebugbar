#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PACKAGE_ROOT="$(cd "${SCRIPT_DIRECTORY}/.." && pwd)"
readonly WORKBENCH_ROOT="${PACKAGE_ROOT}/.workbench"
readonly APPS_ROOT="${WORKBENCH_ROOT}/real-apps"
readonly DEPENDENCIES_ROOT="${WORKBENCH_ROOT}/dependencies"
readonly LOGS_ROOT="${WORKBENCH_ROOT}/logs"

readonly GRID_REPOSITORY="https://github.com/laravel/websockets-grid-demo.git"
readonly GRID_REVISION="39a6064852d2f48ae83b30affad6d17226c621b2"
readonly CHAT_REPOSITORY="https://github.com/laravel/larachat.git"
readonly CHAT_REVISION="eeda0f959d0a165c113baea5201e9b032bdc3e92"
readonly BOOTCAMP_REPOSITORY="https://github.com/laravel/bootcamp.laravel.com.git"
readonly BOOTCAMP_REVISION="0a26c5b565fb0fb93f96a46f9bf6245978707591"
readonly UNFENCED_REPOSITORY="https://github.com/laravel-labs/unfenced.git"
readonly UNFENCED_REVISION="e85f9cd9a555d2797600f0a9d3d5abe3193b8161"

readonly SERVER_WORKERS="${NEWDEBUGBAR_REAL_APPS_SERVER_WORKERS:-4}"
readonly REVERB_PORT="${NEWDEBUGBAR_REAL_APPS_REVERB_PORT:-8171}"

SERVER_PIDS=()

usage() {
    cat <<'EOF'
Set up and serve real Laravel applications with this New Debug Bar checkout.

Usage:
  scripts/real-apps doctor [grid|chat|bootcamp|all]
  scripts/real-apps setup [grid|chat|bootcamp|all]
  scripts/real-apps serve [grid|chat|bootcamp|all]
  scripts/real-apps status [grid|chat|bootcamp|all]
  scripts/real-apps help

Commands:
  doctor  Check the local PHP, SQLite, Node, Composer, Git, and curl runtime.
  setup   Clone, configure, instrument, migrate, seed, and build each app.
  serve   Run each app with php artisan serve until Ctrl-C is pressed.
  status  Show revisions, package state, local package linkage, and URLs.

The default target is all. Runtime files live below .workbench and are ignored.

Runtime overrides:
  NEWDEBUGBAR_REAL_APPS_SERVER_WORKERS  Default: 4
  NEWDEBUGBAR_REAL_APPS_REVERB_PORT     Default: 8171

Applications:
  grid      http://127.0.0.1:8161
  chat      http://127.0.0.1:8162
  bootcamp  http://127.0.0.1:8163

The grid target also starts Laravel Reverb on 127.0.0.1:8171.

For MCP access, start a fresh task inside the selected directory below
.workbench/real-apps after setup. The MCP server runs through that app's artisan.
EOF
}

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

heading() {
    printf '\n%s\n' "$*"
}

target_label() {
    case "$1" in
        grid) printf 'websockets-grid-demo\n' ;;
        chat) printf 'larachat\n' ;;
        bootcamp) printf 'bootcamp.laravel.com\n' ;;
        *) fail "Unknown target: $1" ;;
    esac
}

target_repository() {
    case "$1" in
        grid) printf '%s\n' "${GRID_REPOSITORY}" ;;
        chat) printf '%s\n' "${CHAT_REPOSITORY}" ;;
        bootcamp) printf '%s\n' "${BOOTCAMP_REPOSITORY}" ;;
        *) fail "Unknown target: $1" ;;
    esac
}

target_revision() {
    case "$1" in
        grid) printf '%s\n' "${GRID_REVISION}" ;;
        chat) printf '%s\n' "${CHAT_REVISION}" ;;
        bootcamp) printf '%s\n' "${BOOTCAMP_REVISION}" ;;
        *) fail "Unknown target: $1" ;;
    esac
}

target_directory() {
    printf '%s/%s\n' "${APPS_ROOT}" "$(target_label "$1")"
}

target_port() {
    case "$1" in
        grid) printf '8161\n' ;;
        chat) printf '8162\n' ;;
        bootcamp) printf '8163\n' ;;
        *) fail "Unknown target: $1" ;;
    esac
}

targets() {
    case "$1" in
        grid|chat|bootcamp) printf '%s\n' "$1" ;;
        all) printf 'grid\nchat\nbootcamp\n' ;;
        *) fail "Target must be grid, chat, bootcamp, or all." ;;
    esac
}

require_commands() {
    local command_name

    for command_name in git composer php node npm curl; do
        command -v "${command_name}" >/dev/null 2>&1 || fail "${command_name} is required."
    done
}

check_php() {
    local selection="$1"
    local minimum_version="8.2.0"

    php -r 'exit(version_compare(PHP_VERSION, $argv[1], ">=") ? 0 : 1);' "${minimum_version}" \
        || fail "PHP ${minimum_version} or newer is required for ${selection}."

    php <<'PHP' || fail "Install the missing PHP extensions listed above."
<?php

$required = [
    'curl',
    'dom',
    'json',
    'libxml',
    'mbstring',
    'openssl',
    'pcntl',
    'pdo_sqlite',
    'simplexml',
    'zip',
];

$missing = array_values(array_filter(
    $required,
    static fn (string $extension): bool => ! extension_loaded($extension),
));

if ($missing !== []) {
    fwrite(STDERR, 'Missing PHP extensions: '.implode(', ', $missing).PHP_EOL);
    exit(1);
}
PHP
}

check_node() {
    node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit((major === 20 && minor >= 19) || major >= 22 ? 0 : 1)' \
        || fail "Node 20.19 or Node 22 or newer is required."
}

check_server_workers() {
    case "${SERVER_WORKERS}" in
        ''|*[!0-9]*) fail "NEWDEBUGBAR_REAL_APPS_SERVER_WORKERS must be an integer of at least 2." ;;
    esac

    [ "${SERVER_WORKERS}" -ge 2 ] \
        || fail "NEWDEBUGBAR_REAL_APPS_SERVER_WORKERS must be an integer of at least 2."
}

doctor() {
    local selection="$1"

    targets "${selection}" >/dev/null

    heading "Checking the real-app runtime"
    require_commands
    check_php "${selection}"
    check_node
    check_server_workers

    printf 'PHP %s\n' "$(php -r 'echo PHP_VERSION;')"
    printf 'Node %s\n' "$(node --version)"
    printf '%s\n' "$(composer --version --no-ansi 2>/dev/null)"
    printf 'SQLite support available\n'
    printf 'PHP development server workers: %s\n' "${SERVER_WORKERS}"
}

clone_target() {
    local target="$1"
    local directory repository revision current_repository current_revision

    directory="$(target_directory "${target}")"
    repository="$(target_repository "${target}")"
    revision="$(target_revision "${target}")"

    if [ ! -e "${directory}" ]; then
        heading "Cloning $(target_label "${target}")"
        mkdir -p "${APPS_ROOT}"
        git init --quiet "${directory}"
        git -C "${directory}" remote add origin "${repository}"
        git -C "${directory}" fetch --quiet --depth 1 origin "${revision}"
        git -C "${directory}" checkout --quiet --detach FETCH_HEAD
        return
    fi

    [ -d "${directory}/.git" ] || fail "${directory} exists but is not a Git checkout."

    current_repository="$(git -C "${directory}" config --get remote.origin.url || true)"
    [ "${current_repository}" = "${repository}" ] \
        || fail "$(target_label "${target}") has an unexpected origin: ${current_repository}"

    current_revision="$(git -C "${directory}" rev-parse HEAD 2>/dev/null || true)"
    [ "${current_revision}" = "${revision}" ] \
        || fail "$(target_label "${target}") is not at the pinned revision ${revision}."
}

prepare_bootcamp_dependency() {
    local target="$1"
    local directory current_repository current_revision

    [ "${target}" = "bootcamp" ] || return 0

    directory="${DEPENDENCIES_ROOT}/laravel-unfenced"

    if [ ! -e "${directory}" ]; then
        heading "Cloning laravel/unfenced"
        mkdir -p "${DEPENDENCIES_ROOT}"
        git init --quiet "${directory}"
        git -C "${directory}" remote add origin "${UNFENCED_REPOSITORY}"
        git -C "${directory}" fetch --quiet --depth 1 origin "${UNFENCED_REVISION}"
        git -C "${directory}" checkout --quiet --detach FETCH_HEAD
        return
    fi

    [ -d "${directory}/.git" ] || fail "${directory} exists but is not a Git checkout."

    current_repository="$(git -C "${directory}" config --get remote.origin.url || true)"
    [ "${current_repository}" = "${UNFENCED_REPOSITORY}" ] \
        || fail "laravel/unfenced has an unexpected origin: ${current_repository}"

    current_revision="$(git -C "${directory}" rev-parse HEAD 2>/dev/null || true)"
    [ "${current_revision}" = "${UNFENCED_REVISION}" ] \
        || fail "laravel/unfenced is not at the pinned revision ${UNFENCED_REVISION}."
}

configure_environment() {
    local target="$1"
    local directory database port cookie broadcast_connection="log"

    directory="$(target_directory "${target}")"
    database="${directory}/database/database.sqlite"
    port="$(target_port "${target}")"
    cookie="newdebugbar_${target}_session"

    if [ "${target}" = "grid" ]; then
        broadcast_connection="reverb"
    fi

    mkdir -p "${directory}/database"
    touch "${database}"
    cp "${directory}/.env.example" "${directory}/.env"
    chmod 600 "${directory}/.env"

    (
        export NDB_ENV_FILE="${directory}/.env"
        export NDB_ENV_APP_URL="http://127.0.0.1:${port}"
        export NDB_ENV_DB_DATABASE="${database}"
        export NDB_ENV_SESSION_COOKIE="${cookie}"
        export NDB_ENV_BROADCAST_CONNECTION="${broadcast_connection}"
        export NDB_ENV_REVERB_PORT="${REVERB_PORT}"

        php <<'PHP'
<?php

$file = getenv('NDB_ENV_FILE');
$contents = file_get_contents($file);

$values = [
    'APP_ENV' => 'local',
    'APP_DEBUG' => 'true',
    'APP_URL' => getenv('NDB_ENV_APP_URL'),
    'APP_MAINTENANCE_STORE' => 'file',
    'DB_CONNECTION' => 'sqlite',
    'DB_DATABASE' => getenv('NDB_ENV_DB_DATABASE'),
    'BROADCAST_CONNECTION' => getenv('NDB_ENV_BROADCAST_CONNECTION'),
    'BROADCAST_DRIVER' => getenv('NDB_ENV_BROADCAST_CONNECTION'),
    'CACHE_STORE' => 'file',
    'CACHE_DRIVER' => 'file',
    'SESSION_DRIVER' => 'file',
    'SESSION_COOKIE' => getenv('NDB_ENV_SESSION_COOKIE'),
    'QUEUE_CONNECTION' => 'sync',
    'QUEUE_DRIVER' => 'sync',
    'MAIL_MAILER' => 'log',
    'NEWDEBUGBAR_ENABLED' => 'true',
    'OPENAI_API_KEY' => '',
    'OPENAI_ORGANIZATION' => '',
    'REVERB_APP_ID' => 'newdebugbar-grid',
    'REVERB_APP_KEY' => 'newdebugbar-grid-key',
    'REVERB_APP_SECRET' => 'newdebugbar-grid-secret',
    'REVERB_HOST' => '127.0.0.1',
    'REVERB_PORT' => getenv('NDB_ENV_REVERB_PORT'),
    'REVERB_SCHEME' => 'http',
    'REVERB_SERVER_HOST' => '127.0.0.1',
    'REVERB_SERVER_PORT' => getenv('NDB_ENV_REVERB_PORT'),
    'VITE_REVERB_APP_KEY' => 'newdebugbar-grid-key',
    'VITE_REVERB_HOST' => '127.0.0.1',
    'VITE_REVERB_PORT' => getenv('NDB_ENV_REVERB_PORT'),
    'VITE_REVERB_SCHEME' => 'http',
    'TORCHLIGHT_TOKEN' => '',
];

$encode = static function (string $value): string {
    if ($value === '') {
        return '';
    }

    if (preg_match('/^[A-Za-z0-9_:\/.@+\-]+$/', $value) === 1) {
        return $value;
    }

    return '"'.str_replace(['\\', '"', '$'], ['\\\\', '\\"', '\\$'], $value).'"';
};

foreach ($values as $key => $value) {
    $line = $key.'='.$encode((string) $value);
    $pattern = '/^'.preg_quote($key, '/').'=[^\r\n]*$/m';

    if (preg_match($pattern, $contents) === 1) {
        $contents = preg_replace_callback($pattern, static fn (): string => $line, $contents, 1);
        continue;
    }

    $contents = rtrim($contents).PHP_EOL.$line.PHP_EOL;
}

file_put_contents($file, $contents);
PHP
    )
}

root_requires_package() {
    local directory="$1"
    local section="$2"
    local package="$3"

    php -r '
        $composer = json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR);
        exit(isset($composer[$argv[2]][$argv[3]]) ? 0 : 1);
    ' "${directory}/composer.json" "${section}" "${package}"
}

prepare_php_runtime() {
    local target="$1"
    local directory

    directory="$(target_directory "${target}")"

    (
        export NDB_HOST_APP="${directory}"

        php <<'PHP'
<?php

$file = getenv('NDB_HOST_APP').'/config/database.php';
$contents = file_get_contents($file);
$legacyConstant = 'PDO::MYSQL_ATTR_SSL_CA';
$modernConstant = 'Pdo\\Mysql::ATTR_SSL_CA';
$conditionalConstant = '(PHP_VERSION_ID >= 80500 ? '.$modernConstant.' : '.$legacyConstant.')';
$runtimeConstant = PHP_VERSION_ID >= 80500 ? $modernConstant : $legacyConstant;

$contents = str_replace($conditionalConstant, $runtimeConstant, $contents);
$contents = str_replace(
    PHP_VERSION_ID >= 80500 ? $legacyConstant : $modernConstant,
    $runtimeConstant,
    $contents,
);

file_put_contents($file, $contents);
PHP
    )
}

prepare_target_dependencies() {
    local target="$1"
    local directory

    case "${target}" in
        chat|bootcamp) ;;
        *) return 0 ;;
    esac

    directory="$(target_directory "${target}")"

    (
        export NDB_HOST_APP="${directory}"
        export NDB_HOST_TARGET="${target}"

        php <<'PHP'
<?php

$file = getenv('NDB_HOST_APP').'/composer.json';
$composer = json_decode(file_get_contents($file), true, flags: JSON_THROW_ON_ERROR);

if (getenv('NDB_HOST_TARGET') === 'chat') {
    $composer['require-dev']['pestphp/pest'] = '^4.4';
    $composer['require-dev']['pestphp/pest-plugin-laravel'] = '^4.0';
}

if (getenv('NDB_HOST_TARGET') === 'bootcamp') {
    $composer['require']['php'] = '^8.2';
    $composer['require']['graham-campbell/markdown'] = '^16.1';
    $composer['require']['laravel/framework'] = '^12.0';
    $composer['require']['laravel/sanctum'] = '^4.3';
    $composer['require']['laravel/tinker'] = '^2.10';
    $composer['require']['torchlight/torchlight-commonmark'] = '^0.6';
    $composer['require']['torchlight/torchlight-laravel'] = '^0.6.2';
    $composer['require-dev']['laravel/sail'] = '^1.41';
    $composer['require-dev']['nunomaduro/collision'] = '^8.6';
    $composer['require-dev']['phpunit/phpunit'] = '^11.5';
    $composer['require-dev']['spatie/laravel-ignition'] = '^2.12';

    foreach ($composer['repositories'] ?? [] as $index => $repository) {
        if (($repository['name'] ?? null) === 'unfenced'
            || str_ends_with((string) ($repository['url'] ?? ''), 'laravel-labs/unfenced.git')) {
            $composer['repositories'][$index] = [
                'name' => 'unfenced',
                'type' => 'path',
                'url' => '../../dependencies/laravel-unfenced',
                'options' => [
                    'symlink' => true,
                    'versions' => ['laravel/unfenced' => 'dev-main'],
                ],
            ];
        }
    }

    unset($composer['config']['use-github-api'], $composer['config']['github-protocols']);
}

file_put_contents(
    $file,
    json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL,
);
PHP
    )
}

remove_old_debugbars() {
    local directory="$1"
    local old_debugbar

    for old_debugbar in barryvdh/laravel-debugbar fruitcake/laravel-debugbar; do
        if root_requires_package "${directory}" require-dev "${old_debugbar}"; then
            composer remove --dev "${old_debugbar}" --no-update --no-interaction
        elif root_requires_package "${directory}" require "${old_debugbar}"; then
            composer remove "${old_debugbar}" --no-update --no-interaction
        fi
    done
}

prepare_bootcamp_runtime() {
    local target="$1"
    local directory

    [ "${target}" = "bootcamp" ] || return 0

    directory="$(target_directory "${target}")"

    (
        export NDB_HOST_APP="${directory}"

        php <<'PHP'
<?php

$appRoot = getenv('NDB_HOST_APP');
$root = $appRoot.'/vendor/laravel/unfenced/src/Node';
$files = [
    $root.'/FencedCodeContainer.php' => '        $this->attributes = $this->parseAttributes($fencedCode);',
    $root.'/TabbedCode.php' => '        $this->group = $this->generateTabHash($children);',
];

foreach ($files as $file => $firstStatement) {
    $contents = file_get_contents($file);

    if (! str_contains($contents, '        parent::__construct();')) {
        $contents = str_replace(
            $firstStatement,
            "        parent::__construct();\n\n".$firstStatement,
            $contents,
            $count,
        );

        if ($count !== 1) {
            fwrite(STDERR, 'The Unfenced node constructor changed upstream.'.PHP_EOL);
            exit(1);
        }

        file_put_contents($file, $contents);
    }
}

$localOnlyIntegrations = [
    $appRoot.'/config/markdown.php' => '        Torchlight\\Commonmark\\V2\\TorchlightExtension::class,'.PHP_EOL,
    $appRoot.'/app/Http/Kernel.php' => '        \\Torchlight\\Middleware\\RenderTorchlight::class,'.PHP_EOL,
];

foreach ($localOnlyIntegrations as $file => $line) {
    $contents = file_get_contents($file);

    if (str_contains($contents, $line)) {
        file_put_contents($file, str_replace($line, '', $contents, $count));

        if ($count !== 1) {
            fwrite(STDERR, 'The Torchlight integration changed upstream.'.PHP_EOL);
            exit(1);
        }
    }
}

$javascript = $appRoot.'/resources/js/app.js';
$contents = file_get_contents($javascript);
$contents = str_replace("import Alpine from 'alpinejs';".PHP_EOL, '', $contents);
$contents = str_replace(
    PHP_EOL.'window.Alpine = Alpine;'.PHP_EOL.'Alpine.start();'.PHP_EOL,
    PHP_EOL,
    $contents,
);

if (str_contains($contents, 'Alpine.start()')) {
    fwrite(STDERR, 'The Bootcamp Alpine bootstrap changed upstream.'.PHP_EOL);
    exit(1);
}

file_put_contents($javascript, $contents);
PHP
    )
}

swap_debugbar() {
    local target="$1"
    local directory

    directory="$(target_directory "${target}")"

    heading "Installing New Debug Bar in $(target_label "${target}")"
    prepare_bootcamp_dependency "${target}"
    prepare_php_runtime "${target}"
    prepare_target_dependencies "${target}"

    (
        cd "${directory}"

        composer show newdebugbar/newdebugbar --no-ansi >/dev/null 2>&1 || true
        composer config repositories.newdebugbar path ../../..
        remove_old_debugbars "${directory}"

        if [ "${target}" = "chat" ]; then
            composer update \
                pestphp/pest \
                pestphp/pest-plugin-laravel \
                --with-all-dependencies \
                --minimal-changes \
                --no-interaction \
                --prefer-dist
        fi

        if [ "${target}" = "bootcamp" ]; then
            composer update \
                --no-interaction \
                --prefer-dist
        fi

        composer require --dev newdebugbar/newdebugbar:dev-main \
            --with-all-dependencies \
            --minimal-changes \
            --no-interaction \
            --prefer-dist
    )

    prepare_bootcamp_runtime "${target}"
}

build_target() {
    local target="$1"
    local directory

    directory="$(target_directory "${target}")"

    heading "Preparing $(target_label "${target}")"

    (
        cd "${directory}"

        php artisan key:generate --force --no-interaction
        php artisan optimize:clear --no-interaction

        if find database/migrations -type f -name '*.php' -print -quit 2>/dev/null | grep -q .; then
            php artisan migrate:fresh --force --no-interaction
        fi

        if [ -f database/seeders/DatabaseSeeder.php ]; then
            php artisan db:seed --force --no-interaction
        fi

        if [ -d storage/app/public ] && [ ! -e public/storage ]; then
            php artisan storage:link --no-interaction
        fi

        PUPPETEER_SKIP_DOWNLOAD=true npm ci --no-audit --no-fund
        npm run build
    )
}

verify_target() {
    local target="$1"
    local directory old_debugbar resolved_package resolved_root

    directory="$(target_directory "${target}")"

    (
        cd "${directory}"

        composer show newdebugbar/newdebugbar --no-ansi >/dev/null

        for old_debugbar in barryvdh/laravel-debugbar fruitcake/laravel-debugbar; do
            if composer show "${old_debugbar}" --no-ansi >/dev/null 2>&1; then
                fail "${old_debugbar} is still installed in $(target_label "${target}")."
            fi
        done

        resolved_package="$(cd vendor/newdebugbar/newdebugbar && pwd -P)"
        resolved_root="$(cd "${PACKAGE_ROOT}" && pwd -P)"
        [ "${resolved_package}" = "${resolved_root}" ] \
            || fail "$(target_label "${target}") is not using the local package checkout."

        php artisan env --no-ansi | grep -q 'local' \
            || fail "$(target_label "${target}") is not running in the local environment."
    )

    printf '%s is ready at http://127.0.0.1:%s\n' \
        "$(target_label "${target}")" \
        "$(target_port "${target}")"
}

setup_target() {
    local target="$1"

    clone_target "${target}"
    configure_environment "${target}"
    swap_debugbar "${target}"
    build_target "${target}"
    verify_target "${target}"
}

setup() {
    local selection="$1"
    local target

    doctor "${selection}"

    while IFS= read -r target; do
        setup_target "${target}"
    done < <(targets "${selection}")
}

status_target() {
    local target="$1"
    local directory expected_revision current_revision old_debugbar resolved_package

    directory="$(target_directory "${target}")"
    expected_revision="$(target_revision "${target}")"

    heading "$(target_label "${target}")"

    if [ ! -d "${directory}/.git" ]; then
        printf 'State: not set up\n'
        printf 'Path: %s\n' "${directory}"
        return 1
    fi

    current_revision="$(git -C "${directory}" rev-parse HEAD)"
    printf 'Path: %s\n' "${directory}"
    printf 'Revision: %s\n' "${current_revision}"

    if [ "${current_revision}" != "${expected_revision}" ]; then
        printf 'Pinned revision: %s (mismatch)\n' "${expected_revision}"
        return 1
    fi

    if ! (cd "${directory}" && composer show newdebugbar/newdebugbar --no-ansi >/dev/null 2>&1); then
        printf 'New Debug Bar: missing\n'
        return 1
    fi

    for old_debugbar in barryvdh/laravel-debugbar fruitcake/laravel-debugbar; do
        if (cd "${directory}" && composer show "${old_debugbar}" --no-ansi >/dev/null 2>&1); then
            printf 'Old Debugbar: still installed (%s)\n' "${old_debugbar}"
            return 1
        fi
    done

    resolved_package="$(cd "${directory}/vendor/newdebugbar/newdebugbar" && pwd -P)"
    if [ "${resolved_package}" != "$(cd "${PACKAGE_ROOT}" && pwd -P)" ]; then
        printf 'New Debug Bar: installed, but not linked to this checkout\n'
        return 1
    fi

    printf 'New Debug Bar: linked to this checkout\n'
    printf 'Old Debugbar: absent\n'
    printf 'URL: http://127.0.0.1:%s\n' "$(target_port "${target}")"
}

status() {
    local selection="$1"
    local target result=0

    while IFS= read -r target; do
        status_target "${target}" || result=1
    done < <(targets "${selection}")

    return "${result}"
}

cleanup_servers() {
    local pid

    trap - EXIT INT TERM

    for pid in "${SERVER_PIDS[@]}"; do
        kill "${pid}" >/dev/null 2>&1 || true
    done

    for pid in "${SERVER_PIDS[@]}"; do
        wait "${pid}" >/dev/null 2>&1 || true
    done
}

wait_for_server() {
    local target="$1"
    local pid="$2"
    local port log_file response_headers attempt=0

    port="$(target_port "${target}")"
    log_file="${LOGS_ROOT}/${target}.log"

    while [ "${attempt}" -lt 60 ]; do
        if ! kill -0 "${pid}" >/dev/null 2>&1; then
            tail -n 30 "${log_file}" >&2 || true
            fail "$(target_label "${target}") exited before it became ready."
        fi

        if response_headers="$(curl --fail --silent --dump-header - --output /dev/null "http://127.0.0.1:${port}" 2>/dev/null)" \
            && printf '%s\n' "${response_headers}" | grep -qi '^X-NewDebugBar-Profile:'; then
            printf '%s is running at http://127.0.0.1:%s\n' "$(target_label "${target}")" "${port}"
            return
        fi

        attempt=$((attempt + 1))
        sleep 1
    done

    tail -n 30 "${log_file}" >&2 || true
    fail "$(target_label "${target}") did not become ready within 60 seconds."
}

wait_for_port() {
    local label="$1"
    local pid="$2"
    local port="$3"
    local log_file="$4"
    local attempt=0

    while [ "${attempt}" -lt 60 ]; do
        if ! kill -0 "${pid}" >/dev/null 2>&1; then
            tail -n 30 "${log_file}" >&2 || true
            fail "${label} exited before it became ready."
        fi

        if php -r '
            $socket = @fsockopen("127.0.0.1", (int) $argv[1], $errorCode, $errorMessage, 0.2);
            exit(is_resource($socket) ? 0 : 1);
        ' "${port}"; then
            printf '%s is running on 127.0.0.1:%s\n' "${label}" "${port}"
            return
        fi

        attempt=$((attempt + 1))
        sleep 1
    done

    tail -n 30 "${log_file}" >&2 || true
    fail "${label} did not become ready within 60 seconds."
}

start_grid_reverb() {
    local target="$1"
    local directory log_file pid

    [ "${target}" = "grid" ] || return 0

    directory="$(target_directory "${target}")"
    log_file="${LOGS_ROOT}/${target}-reverb.log"
    : > "${log_file}"

    (
        cd "${directory}"
        exec php artisan reverb:start \
            --host=127.0.0.1 \
            --port="${REVERB_PORT}" \
            --no-interaction
    ) >"${log_file}" 2>&1 &

    pid=$!
    SERVER_PIDS+=("${pid}")
    wait_for_port "Laravel Reverb" "${pid}" "${REVERB_PORT}" "${log_file}"
}

start_server() {
    local target="$1"
    local directory port log_file pid

    directory="$(target_directory "${target}")"
    port="$(target_port "${target}")"
    log_file="${LOGS_ROOT}/${target}.log"

    [ -f "${directory}/artisan" ] || fail "Run setup for $(target_label "${target}") first."
    verify_target "${target}"

    mkdir -p "${LOGS_ROOT}"
    : > "${log_file}"
    start_grid_reverb "${target}"

    (
        cd "${directory}"
        export PHP_CLI_SERVER_WORKERS="${SERVER_WORKERS}"
        exec php artisan serve --host=127.0.0.1 --port="${port}" --no-reload --no-interaction
    ) >"${log_file}" 2>&1 &

    pid=$!
    SERVER_PIDS+=("${pid}")
    wait_for_server "${target}" "${pid}"
}

serve() {
    local selection="$1"
    local target

    require_commands
    check_server_workers
    mkdir -p "${LOGS_ROOT}"
    trap cleanup_servers EXIT INT TERM

    while IFS= read -r target; do
        start_server "${target}"
    done < <(targets "${selection}")

    printf '\nLogs are in %s. Press Ctrl-C to stop.\n' "${LOGS_ROOT}"

    while true; do
        for pid in "${SERVER_PIDS[@]}"; do
            kill -0 "${pid}" >/dev/null 2>&1 || fail "A real-app server stopped unexpectedly."
        done

        sleep 1
    done
}

main() {
    local command="${1:-help}"
    local selection="${2:-all}"

    if [ "$#" -gt 2 ]; then
        fail "Too many arguments."
    fi

    case "${command}" in
        doctor) doctor "${selection}" ;;
        setup) setup "${selection}" ;;
        serve) serve "${selection}" ;;
        status) status "${selection}" ;;
        help|-h|--help) usage ;;
        *) usage >&2; fail "Unknown command: ${command}" ;;
    esac
}

main "$@"
