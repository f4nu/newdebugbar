{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "newdebugbar/newdebugbar",
    "description": "A modern Laravel debug bar built with Livewire.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Benjamin Crozat"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^0.9",
        "livewire/livewire": "^4.1"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "NewDebugBar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NewDebugBar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "test": [
            "@test:php",
            "npm test",
            "@test:browser"
        ],
        "test:browser": [
            "npm run build",
            "pest --testsuite=Browser"
        ],
        "test:php": "pest --testsuite=Package",
        "benchmark": "php benchmarks/profile-overhead.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NewDebugBar\\NewDebugBarServiceProvider"
            ]
        }
    },
    "archive": {
        "exclude": [
            "/.gitattributes",
            "/.editorconfig",
            "/.github",
            "/.gitignore",
            "/.phpunit.cache",
            "/benchmarks",
            "/composer.lock",
            "/node_modules",
            "/package-lock.json",
            "/package.json",
            "/phpunit.xml.dist",
            "/resources/css",
            "/resources/js",
            "/scripts",
            "/tests",
            "/vite.config.js",
            "/vendor"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
